# Local development settings. ./run.sh copies this file to .env on first run and
# replaces every "generate-on-first-run" value with a random secret.
# These accounts and secrets are for your own machine only. Never reuse them anywhere else.

# --- Dashboard (Next.js) ------------------------------------------------------
PORT=3000
DASHBOARD_URL=http://localhost:3000
# Public, compiled into the browser bundle. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API ----------------------------------------------------------------------
# devapi  = bundled local API in dev-api/ (default, works out of the box)
# backend = your cyenetic-backend checkout at BACKEND_DIR, started with BACKEND_CMD
API_MODE=devapi
BACKEND_DIR=../cyenetic-backend
BACKEND_CMD="npm run dev"
DEV_API_PORT=4000
DEV_API_SECRET=generate-on-first-run

# --- Sign-in accounts (seeded by the local API on every start) ------------------
# Sign in at http://localhost:3000/login, then read the 6-digit code at http://localhost:8025
DEV_ADMIN_EMAIL=admin@cyenetic.local
DEV_ADMIN_PASSWORD=Cyenetic-Admin-2026!
DEV_ADMIN_NAME="Dev Super Admin"
DEV_EDITOR_EMAIL=editor@cyenetic.local
DEV_EDITOR_PASSWORD=Cyenetic-Editor-2026!
DEV_EDITOR_NAME="Dev Content Editor"
DEV_AUDITOR_EMAIL=auditor@cyenetic.local
DEV_AUDITOR_PASSWORD=Cyenetic-Auditor-2026!
DEV_AUDITOR_NAME="Dev Security Auditor"

# --- Mail (Mailpit catches every email; inbox at http://localhost:8025) ---------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@cyenetic.local
SMTP_SECURE=false
MAILPIT_UI_PORT=8025

# --- Upload storage ---------------------------------------------------------------
# local = files saved on disk in .dev-data/uploads and served by the dev API (default, no Docker needed)
# minio = MinIO in Docker (console at http://localhost:9001), using the S3_* settings below
STORAGE_DRIVER=local
# Address the browser uses to reach the dev API; local upload links are built from it.
# Defaults to http://localhost:$DEV_API_PORT. Uncomment only if the browser reaches the API another way.
# DEV_API_PUBLIC_URL=http://localhost:4000

# --- MinIO (only used when STORAGE_DRIVER=minio) -----------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cyenetic
S3_SECRET_KEY=generate-on-first-run
S3_PUBLIC_BUCKET=cyenetic-public
S3_PRIVATE_BUCKET=cyenetic-private
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL and Redis (only started when API_MODE=backend) -------------------
POSTGRES_USER=cyenetic
POSTGRES_PASSWORD=generate-on-first-run
POSTGRES_DB=cyenetic
POSTGRES_PORT=5432
REDIS_PORT=6379
